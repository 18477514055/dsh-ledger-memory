{
  "name": "dsh-ledger-memory",
  "version": "1.2.7",
  "description": "台账记忆（Ledger Memory）—— 给 DSH 一个项目自己的记忆载体：活跃台账每回合自动注入、只追加的回合流水与活动日志（L0–L4，含逐字存档）、关键决策/目标树/经验教训的卡片化记忆，压缩前抓逐字胶囊、压缩后连台账一起注回，把对话锁定到某个项目目录（跨重启保持），以及跨会话的交接单闭环。可回溯、可追查。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ledger",
    "memory",
    "context",
    "compaction",
    "triage",
    "handoff",
    "traceability",
    "agent"
  ],
  "license": "MIT",
  "author": "陈黛华 (https://github.com/18477514055)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/18477514055/dsh-ledger-memory.git"
  },
  "homepage": "https://github.com/18477514055/dsh-ledger-memory#readme",
  "bugs": {
    "url": "https://github.com/18477514055/dsh-ledger-memory/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node tools/selftest.mjs",
    "probes": "node tools/_probe-assertion-can-fail.mjs && node tools/_probe-dirty-source.mjs && node tools/_probe-capsule-persistence.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.2-alpha.2",
      "dshReleases": {
        "rc.7": "unknown",
        "rc.8": "unknown",
        "0.1.1-rc.1": "unknown",
        "0.1.1-rc.2": "unknown",
        "0.1.2-alpha.2": "compatible",
        "0.1.2-alpha.3": "compatible",
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.1": "unknown",
        "0.1.3-alpha.2": "unknown",
        "0.1.5-alpha.1": "unknown",
        "0.1.5-alpha.2": "unknown",
        "0.1.5-rc.1": "unknown",
        "0.1.5-rc.2": "unknown",
        "0.1.5-rc.3": "unknown",
        "0.1.6-alpha.1": "unknown",
        "0.1.6-alpha.2": "unknown",
        "0.1.7-alpha.1": "unknown",
        "0.1.7-alpha.2": "unknown",
        "0.1.7-rc.1": "unknown",
        "0.1.7-rc.2": "unknown",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "unknown",
        "0.2.1-alpha.2": "unknown",
        "0.2.1-alpha.3": "unknown",
        "0.2.1-alpha.4": "unknown",
        "0.2.1-alpha.5": "unknown",
        "0.2.1-rc.1": "unknown",
        "0.2.1-rc.2": "compatible"
      },
      "dshOperations": {
        "0.2.0-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "passed"
        }
      },
      "profiles": [
        "desktop",
        "web"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
